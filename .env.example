# Copy to .env and fill in. .env is gitignored; this file is not — keep it
# free of real secrets.

# data.go.kr open API. One key, but it must be registered per dataset —
# 활용신청 on BOTH of these pages, or the second one answers -401:
#   15071311 혼잡도정보          https://www.data.go.kr/data/15071311/fileData.do
#   15099316 역사 좌표(위경도)    https://www.data.go.kr/data/15099316/fileData.do
# Either the encoding or decoding key works; it is appended raw.
ODCLOUD_SERVICE_KEY=

# Optional. Leave blank to auto-discover the newest published version from the
# OpenAPI spec. Set only to pin a specific historical version.
ODCLOUD_UDDI=

# Optional. Derived from the discovered file's date when blank.
QUARTER=
